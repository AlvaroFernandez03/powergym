# Copia este archivo como ".env" y cambia el valor del JWT_SECRET por algo tuyo
PORT=3000
JWT_SECRET=cambia_esto_por_una_frase_secreta_larga_y_unica

# El usuario que se registre (o inicie sesión) con este email se convierte automáticamente
# en administrador y podrá gestionar las clases desde admin.html
ADMIN_EMAIL=tu-email@ejemplo.com

# Email de bienvenida y confirmación de reservas (opcional).
# Consigue una clave gratuita en https://resend.com — si la dejas vacía, la web funciona
# igual mas no se enviarán emails.
RESEND_API_KEY=

# URL donde corre tu web (para los enlaces que van dentro de los emails)
FRONTEND_URL=http://localhost:3000

# Solo para la demo pública del portfolio (Render): cinta con las cuentas de
# prueba y cambios de contraseña bloqueados. En tu ordenador, déjalo sin poner.
# DEMO=1
